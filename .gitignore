.env
.env.*
!.env.example
*.keystore
*.jks
key.properties

# --- 系统 / 编辑器 ---
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# --- 日志 ---
*.log

# --- 构建产物 ---
