page {
  background: #F4F6FB;
  color: #17233D;
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", sans-serif;
  font-size: 28rpx;
}
.page { padding: 24rpx 24rpx 60rpx; }

/* 顶部 */
.hero {
  padding: 32rpx 28rpx 36rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #1B3A8C 0%, #2B6CF6 100%);
  color: #fff;
  margin-bottom: 24rpx;
}
.hero-title { font-size: 44rpx; font-weight: 700; letter-spacing: 2rpx; }
.hero-sub { margin-top: 12rpx; font-size: 24rpx; opacity: .85; line-height: 1.6; }

/* 卡片 */
.card {
  background: #fff;
  border-radius: 22rpx;
  padding: 26rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(23, 35, 61, .05);
}
.card-title { font-size: 30rpx; font-weight: 600; margin-bottom: 16rpx; }

/* 入口 */
.entry { display: flex; align-items: center; }
.entry-icon {
  width: 84rpx; height: 84rpx; border-radius: 20rpx;
  background: #EEF3FF; color: #2B6CF6;
  display: flex; align-items: center; justify-content: center;
  font-size: 40rpx; margin-right: 22rpx;
}
.entry-body { flex: 1; }
.entry-title { font-size: 31rpx; font-weight: 600; }
.entry-desc { margin-top: 8rpx; font-size: 23rpx; color: #66708A; line-height: 1.5; }
.entry-arrow { color: #B7BFD2; font-size: 40rpx; margin-left: 10rpx; }

/* 统计 */
.stat-row { display: flex; gap: 20rpx; margin: 8rpx 0 24rpx; }
.stat {
  flex: 1; background: #fff; border-radius: 20rpx; padding: 22rpx;
  text-align: center; box-shadow: 0 2rpx 12rpx rgba(23, 35, 61, .05);
}
.stat-num { font-size: 40rpx; font-weight: 700; color: #2B6CF6; }
.stat-label { font-size: 22rpx; color: #66708A; margin-top: 6rpx; }

.footnote { font-size: 22rpx; color: #939CB2; line-height: 1.7; padding: 0 8rpx; }

/* 按钮 */
.btn {
  height: 88rpx; line-height: 88rpx; border-radius: 18rpx;
  text-align: center; font-size: 30rpx; font-weight: 600;
}
.btn-primary { background: #2B6CF6; color: #fff; }
.btn-primary.disabled { background: #A9C0F4; }
.btn-ghost { background: #EEF3FF; color: #2B6CF6; }
.btn-mini {
  display: inline-block; padding: 0 24rpx; height: 64rpx; line-height: 64rpx;
  border-radius: 14rpx; font-size: 25rpx; background: #EEF3FF; color: #2B6CF6;
  margin-right: 16rpx;
}

/* 状态 */
.center { text-align: center; padding: 60rpx 0; }
.muted { color: #66708A; font-size: 24rpx; }
.tag {
  display: inline-block; padding: 4rpx 16rpx; border-radius: 10rpx;
  font-size: 21rpx; background: #EEF3FF; color: #2B6CF6; margin: 0 10rpx 10rpx 0;
}
.ok { color: #12B76A; } .warn { color: #F2A33A; } .err { color: #E5484D; }
.divider { height: 1rpx; background: #EDF0F7; margin: 20rpx 0; }

/* 输入 */
.textarea {
  width: 100%; min-height: 300rpx; background: #F8FAFE; border-radius: 16rpx;
  padding: 20rpx; font-size: 25rpx; line-height: 1.7; box-sizing: border-box;
}
.placeholder { color: #A9B2C6; }
