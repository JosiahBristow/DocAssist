<view class="page">
  <view class="card">
    <view class="card-title">粘贴英文段落</view>
    <view class="muted">先抽取术语并统一译名，再逐段翻译，避免同一术语前后译法不一致。</view>
    <view style="height:18rpx"></view>
    <textarea class="textarea" value="{{src}}" bindinput="onInput" maxlength="-1"
      placeholder="Abstract / Introduction / 任意一段英文都可以" placeholder-class="placeholder"></textarea>
    <view style="height:16rpx"></view>
    <view class="row">
      <view class="btn btn-ghost half" bindtap="pasteFromClipboard">粘贴</view>
      <view class="btn btn-mini" style="height:88rpx;line-height:88rpx" bindtap="run">翻译</view>
    </view>
  </view>

  <view wx:if="{{loading}}" class="card center">
    <view class="spinner"></view>
    <view class="muted" style="margin-top:16rpx">正在抽取术语并翻译…</view>
  </view>

  <view wx:if="{{errorMsg}}" class="card">
    <view class="card-title err">出错了</view>
    <view class="muted">{{errorMsg}}</view>
  </view>

  <block wx:if="{{done}}">
    <view class="card">
      <view class="card-title">术语表（{{terms.length}}）</view>
      <view class="term-row" wx:for="{{terms}}" wx:key="en">
        <text class="term-en">{{item.en}}</text>
        <text class="term-zh">{{item.zh}}</text>
      </view>
    </view>

    <view class="card" wx:for="{{segments}}" wx:key="src">
      <view class="card-title">译文</view>
      <view class="dst">{{item.dst}}</view>
      <view class="divider"></view>
      <view class="src-label">原文</view>
      <view class="src">{{item.src}}</view>
    </view>

    <view class="btn btn-primary" bindtap="copyAll">复制全部译文</view>
  </block>
</view>
