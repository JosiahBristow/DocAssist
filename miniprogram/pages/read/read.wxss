.needkey {
  margin-top: 12rpx; padding: 14rpx 18rpx; background: #FFF8E8;
  border-radius: 12rpx; font-size: 22rpx; color: #8A5A00; line-height: 1.6;
}
.needkey .link { color: #2B6CF6; }
.spinner {
  width: 56rpx; height: 56rpx; margin: 0 auto;
  border: 6rpx solid #EEF3FF; border-top-color: #2B6CF6;
  border-radius: 50%; animation: spin .9s linear infinite;
}
@keyframes spin { to { transform: rotate(360deg); } }
.hl-title { font-size: 32rpx; font-weight: 700; margin-top: 12rpx; line-height: 1.5; }
.one-line {
  margin-top: 14rpx; padding: 18rpx 20rpx; background: #EEF3FF;
  border-radius: 14rpx; color: #1B3A8C; font-size: 27rpx; line-height: 1.6;
}
.tags { margin-top: 16rpx; }
.tabs { display: flex; background: #fff; border-radius: 18rpx; padding: 8rpx; margin-bottom: 20rpx; }
.tab { flex: 1; text-align: center; padding: 16rpx 0; font-size: 26rpx; color: #66708A; border-radius: 14rpx; }
.tab.on { background: #EEF3FF; color: #2B6CF6; font-weight: 600; }
.sec-label { font-size: 24rpx; color: #2B6CF6; font-weight: 600; margin-bottom: 10rpx; }
.sec-body { font-size: 27rpx; line-height: 1.75; color: #2A3550; }
.li { display: flex; margin-bottom: 12rpx; }
.li-dot { color: #2B6CF6; margin-right: 10rpx; }
.li-text { flex: 1; font-size: 27rpx; line-height: 1.7; }
.term { padding: 14rpx 0; border-bottom: 1rpx solid #EDF0F7; }
.term-en { font-size: 26rpx; font-weight: 600; color: #17233D; }
.term-zh { font-size: 26rpx; color: #2B6CF6; margin-top: 4rpx; }
.term-note { font-size: 22rpx; color: #66708A; margin-top: 6rpx; line-height: 1.6; }
