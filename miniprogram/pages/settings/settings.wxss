.row { display: flex; gap: 16rpx; }
.half { flex: 1; }
.state-row { display: flex; align-items: center; }
.state-dot { color: #B7BFD2; margin-right: 10rpx; font-size: 22rpx; }
.state-dot.on { color: #12B76A; }
.state-text { flex: 1; font-size: 26rpx; }
.link { color: #2B6CF6; font-size: 25rpx; }
.input {
  background: #F8FAFE; border-radius: 14rpx; padding: 20rpx;
  font-size: 26rpx; height: 88rpx; box-sizing: border-box;
}
.test { margin-top: 16rpx; font-size: 23rpx; line-height: 1.6; }
