<view class="page">
  <view class="card">
    <view class="card-title">粘贴参考文献</view>
    <view class="muted">从 Word、知网或英文论文里直接复制整段，一行一条，不用整理编号。英文论文的参考文献（ACL / IEEE 体例）会自动识别并转换为国标格式。</view>
    <view style="height:18rpx"></view>
    <textarea class="textarea" value="{{input}}" bindinput="onInput" maxlength="-1"
      placeholder="例：[1] 周志华. 机器学习[M]. 北京: 清华大学出版社, 2016." placeholder-class="placeholder"></textarea>
    <view wx:if="{{fromPdf}}" class="hint">已从 PDF 自动导入 {{input ? '参考文献段' : ''}}</view>
    <view style="height:20rpx"></view>
    <view class="row">
      <view class="btn btn-ghost half" bindtap="pasteFromClipboard">粘贴</view>
      <view class="btn btn-ghost half" bindtap="loadSample">示例</view>
    </view>
    <view style="height:16rpx"></view>
    <view class="btn btn-primary" bindtap="check">开始检查（按 GB/T 7714-2015）</view>
  </view>

  <!-- 结果总览 -->
  <block wx:if="{{result}}">
    <view class="card summary">
      <view class="sum-row">
        <view class="sum-item">
          <view class="sum-num">{{result.total}}</view>
          <view class="sum-label">条文献</view>
        </view>
        <view class="sum-item">
          <view class="sum-num {{result.passRate >= 80 ? 'ok' : (result.passRate >= 50 ? 'warn' : 'err')}}">{{result.passRate}}%</view>
          <view class="sum-label">通过率</view>
        </view>
        <view class="sum-item">
          <view class="sum-num err">{{result.errCount}}</view>
          <view class="sum-label">有问题</view>
        </view>
      </view>
      <view class="muted">{{result.summary}}</view>
      <view wx:if="{{result.convertedCount}}" class="convnote">检测到 {{result.convertedCount}} 条外文文献，已按 GB/T 7714 改写：姓前名缩写、>3 人加 et al.、arXiv 预印本转为 [EB/OL] 并补引用日期。</view>
      <view class="divider"></view>
      <view class="row">
        <view class="btn-mini" bindtap="fixAll">一键修正全部</view>
        <view class="btn-mini" bindtap="copyList">复制文献表</view>
        <view class="btn-mini" bindtap="copyBib">复制 BibTeX</view>
      </view>
      <view class="row">
        <view class="btn-mini" bindtap="switchSort">{{sortOn ? '✓ ' : ''}}按首作者排序</view>
        <view class="btn-mini" bindtap="clearAll">清空</view>
      </view>
    </view>

    <!-- 逐条 -->
    <view class="item {{item.stats.errs > 0 ? 'bad' : (item.stats.warns > 0 ? 'mid' : 'good')}}"
      wx:for="{{result.items}}" wx:key="index" data-i="{{index}}" bindtap="toggle">
      <view class="item-head">
        <view class="item-no">{{index + 1}}</view>
        <view class="item-type">{{item.typeName || '未识别类型'}}</view>
        <text wx:if="{{item.converted}}" class="badge">外文→国标</text>
        <view class="item-score {{item.score >= 80 ? 'ok' : (item.score >= 50 ? 'warn' : 'err')}}">{{item.score}} 分</view>
      </view>
      <view class="item-orig">{{item.original}}</view>
      <view wx:if="{{item.duplicateOf}}" class="muted err">与第 {{item.duplicateOf}} 条重复</view>

      <block wx:if="{{open[index]}}">
        <view class="divider"></view>
        <view class="prob" wx:for="{{item.problems}}" wx:for-item="p" wx:key="id">
          <text class="dot {{p.level}}">{{p.level === 'error' ? '✕' : (p.level === 'warn' ? '!' : 'i')}}</text>
          <view class="prob-body">
            <view class="prob-rule">{{p.rule}}</view>
            <view class="prob-hint">{{p.hint}}</view>
          </view>
        </view>
        <view wx:if="{{item.changed}}" class="fixed-box">
          <view class="fixed-label">{{item.converted ? '已转换为国标格式' : '建议改为'}}</view>
          <view class="fixed-text">{{item.fixed}}</view>
          <view class="btn-mini" data-i="{{index}}" catchtap="copyOne">复制这条</view>
        </view>
      </block>
      <view wx:else class="muted more">{{item.converted ? '点开看转换说明' : '点开看 ' + item.problems.length + ' 个问题'}} ›</view>
    </view>

    <view class="footnote">校验依据 GB/T 7714-2015《信息与文献 参考文献著录规则》。各期刊社可能有更细的内部要求，最终以投稿指南为准。</view>
  </block>
</view>
